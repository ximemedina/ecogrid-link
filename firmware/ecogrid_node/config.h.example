#pragma once

// Copia este archivo a "config.h" (en la misma carpeta) y rellena tus valores.
// "config.h" NO se sube a GitHub (ver .gitignore) porque contiene tu contraseña de WiFi.

// --- WiFi ---
#define WIFI_SSID "TU_RED_WIFI"
#define WIFI_PASSWORD "TU_PASSWORD"

// --- MQTT ---
// Si el broker corre en la laptop del Integrante 1 y estás en la misma red,
// usa su IP local (ej. 192.168.1.100). Si te conectas por internet, usa el
// host:puerto que te da el túnel de ngrok (ver README.md > Firmware ESP32).
#define MQTT_BROKER "192.168.1.100"
#define MQTT_PORT 1883

// --- Identidad de cada canal ---
// El circuito físico ya está armado con 2 canales de relevador agrupados
// por prioridad (no es posible separarlos en LEDs independientes por nodo):
//
// Canal 1 -> zona PRIORITARIA (nunca se desconecta)
#define NODE_ID_CH1_A "hospital"
#define NODE_ID_CH1_B "bomberos"
//
// Canal 2 -> zona NO PRIORITARIA (se desconecta sola si hay sobrecarga)
#define NODE_ID_CH2_A "casa1"
#define NODE_ID_CH2_B "casa2"
//
// Los 2 canales comparten un único sensor INA219 (va antes de la división
// en ramas), así que mide la corriente TOTAL del circuito, no por canal.
// Los 4 nodos (hospital, bomberos, casa1, casa2) reportan la misma lectura
// de voltaje/corriente en cada ciclo. Una orden de corte para cualquiera de
// los 2 nodos de un canal apaga el canal completo (los 2 LEDs de ese grupo).

// --- Hardware ---
// Pines de control (IN) del relevador de 2 canales. El circuito es:
// 5V -> INA219 (único) -> se divide en Relevador CH1 (COM/NO) -> 3 LEDs
// y Relevador CH2 (COM/NO) -> 3 LEDs, cada LED en paralelo con su propio
// resistor 220-330 Ohm, todo a GND.
// Este módulo de relevador es activo en LOW (LOW = encendido/conectado,
// HIGH = apagado/desconectado) — el firmware ya lo maneja así.
#define PIN_RELAY_CH1 18
#define PIN_RELAY_CH2 19

#define INTERVALO_ENVIO_MS 3000 // Cada cuánto se publica una lectura de telemetría (ambos canales)
