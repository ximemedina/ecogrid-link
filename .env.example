# Copia este archivo a ".env" y ajusta los valores antes de levantar el stack.
# "docker compose" carga .env automáticamente desde la raíz del proyecto.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_DATABASE=ecogrid_link_db
MYSQL_USER=ecogrid_user
MYSQL_PASSWORD=ecogrid_user_password

# --- Grafana (Integrante 2) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Backend / Lógica de balanceo ---
UMBRAL_SOBRECARGA_WATTS=50.0
